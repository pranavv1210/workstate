{
  "name": "workstate",
  "displayName": "WorkState",
  "description": "Preserve engineering context across AI coding sessions in VS Code.",
  "version": "0.2.3",
  "author": {
    "name": "Pranav",
    "url": "https://github.com/pranavv1210"
  },
  "icon": "media/workstate.png",
  "publisher": "pranavv1210",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pranavv1210/workstate.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "context",
    "handoff",
    "ai-coding",
    "coding-agents",
    "developer-memory",
    "local-first",
    "codex",
    "claude",
    "copilot",
    "gemini",
    "productivity"
  ],
  "activationEvents": [
    "onView:workstate.sidebar",
    "onCommand:workstate.createWorkState",
    "onCommand:workstate.quickUpdate",
    "onCommand:workstate.quickCapture",
    "onCommand:workstate.openActiveWorkState",
    "onCommand:workstate.editWorkState",
    "onCommand:workstate.createQuickHandoff",
    "onCommand:workstate.createFullHandoff",
    "onCommand:workstate.copyHandoff",
    "onCommand:workstate.continueWork",
    "onCommand:workstate.reviewContext",
    "onCommand:workstate.providerStatus",
    "onCommand:workstate.viewTaskDna",
    "onCommand:workstate.archiveWorkState",
    "onChatParticipant:workstate.chat",
    "onLanguageModelTool:workstate_get_context",
    "onLanguageModelTool:workstate_get_resume_state",
    "onLanguageModelTool:workstate_update_context",
    "onLanguageModelTool:workstate_save_decision",
    "onLanguageModelTool:workstate_reconcile",
    "onLanguageModelTool:workstate_get_handoff"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workstate",
          "title": "WorkState",
          "icon": "media/workstate-activity.svg"
        }
      ]
    },
    "views": {
      "workstate": [
        {
          "id": "workstate.sidebar",
          "name": "WorkState",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "workstate.createWorkState",
        "title": "WorkState: Start Remembering"
      },
      {
        "command": "workstate.quickUpdate",
        "title": "WorkState: Quick Update"
      },
      {
        "command": "workstate.quickCapture",
        "title": "WorkState: Quick Capture"
      },
      {
        "command": "workstate.openActiveWorkState",
        "title": "WorkState: Open Active WorkState"
      },
      {
        "command": "workstate.editWorkState",
        "title": "WorkState: Edit WorkState"
      },
      {
        "command": "workstate.createQuickHandoff",
        "title": "WorkState: Handoff"
      },
      {
        "command": "workstate.createFullHandoff",
        "title": "WorkState: Full Context"
      },
      {
        "command": "workstate.copyHandoff",
        "title": "WorkState: Copy Handoff"
      },
      {
        "command": "workstate.continueWork",
        "title": "WorkState: Continue Work"
      },
      {
        "command": "workstate.reviewContext",
        "title": "WorkState: Review Context"
      },
      {
        "command": "workstate.providerStatus",
        "title": "WorkState: AI Provider Status"
      },
      {
        "command": "workstate.viewTaskDna",
        "title": "WorkState: View Task DNA"
      },
      {
        "command": "workstate.archiveWorkState",
        "title": "WorkState: Archive WorkState"
      }
    ],
    "keybindings": [
      {
        "command": "workstate.quickCapture",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "when": "workspaceFolderCount != 0"
      }
    ],
    "chatParticipants": [
      {
        "id": "workstate.chat",
        "name": "workstate",
        "fullName": "WorkState",
        "description": "Ask WorkState where you left off or prepare context for another AI coding session.",
        "isSticky": false,
        "commands": [
          {
            "name": "resume",
            "description": "Show the compact resume state for this workspace."
          },
          {
            "name": "handoff",
            "description": "Prepare copy-assisted context for another AI coding agent."
          },
          {
            "name": "reconcile",
            "description": "Reconcile saved WorkState context with current Git and workspace evidence."
          },
          {
            "name": "decision",
            "description": "Save a decision to the current workspace WorkState."
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "workstate_get_context",
        "tags": [
          "workstate",
          "context"
        ],
        "toolReferenceName": "workstateContext",
        "displayName": "Get WorkState Context",
        "modelDescription": "Returns compact, trusted engineering context for the current VS Code workspace from local WorkState state, Git evidence, recent activity, decisions, rejected approaches, blockers, tests, and relevant files. Use this when an AI coding agent needs to understand what the developer was working on. Do not use it to read secrets or raw workspace files.",
        "userDescription": "Get compact WorkState context for the current workspace.",
        "canBeReferencedInPrompt": true,
        "icon": "$(debug-continue)",
        "when": "workspaceFolderCount != 0",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "current",
                "recent",
                "project",
                "resume"
              ],
              "description": "Context scope to retrieve. Use resume when starting or continuing an AI coding session.",
              "default": "current"
            }
          }
        }
      },
      {
        "name": "workstate_get_resume_state",
        "tags": [
          "workstate",
          "context",
          "resume"
        ],
        "toolReferenceName": "workstateResume",
        "displayName": "Get WorkState Resume State",
        "modelDescription": "Returns exactly the compact WorkState context a new AI coding session needs to continue: project, current focus, state, completed work, decisions, rejected approaches, blockers, tests, relevant files, Git state, reconciliation/conflicts, and next action.",
        "userDescription": "Get the continuation context for this workspace.",
        "canBeReferencedInPrompt": true,
        "icon": "$(debug-start)",
        "when": "workspaceFolderCount != 0",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "workstate_update_context",
        "tags": [
          "workstate",
          "context",
          "write"
        ],
        "toolReferenceName": "workstateUpdate",
        "displayName": "Update WorkState Context",
        "modelDescription": "Saves a meaningful engineering context update to local WorkState for the current workspace. Use only for developer-relevant progress such as completed work, current state, decisions, rejected approaches, blockers, tests, next actions, or notes. Do not store secrets or raw credentials.",
        "userDescription": "Save a meaningful context update to WorkState.",
        "canBeReferencedInPrompt": true,
        "icon": "$(save)",
        "when": "workspaceFolderCount != 0",
        "inputSchema": {
          "type": "object",
          "required": [
            "type",
            "content"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "completed",
                "current_state",
                "decision",
                "rejected",
                "blocker",
                "test",
                "next_action",
                "note"
              ],
              "description": "The kind of engineering context being saved."
            },
            "content": {
              "type": "string",
              "description": "The concise context to save."
            },
            "reason": {
              "type": "string",
              "description": "Optional reason, especially for decisions and rejected approaches."
            },
            "evidence": {
              "type": "string",
              "description": "Optional source/evidence for the update."
            }
          }
        }
      },
      {
        "name": "workstate_save_decision",
        "tags": [
          "workstate",
          "decision",
          "write"
        ],
        "toolReferenceName": "workstateDecision",
        "displayName": "Save WorkState Decision",
        "modelDescription": "Saves a confirmed engineering decision to local WorkState for the current workspace. Use only when the developer or workspace context clearly establishes a decision.",
        "userDescription": "Save an engineering decision to WorkState.",
        "canBeReferencedInPrompt": true,
        "icon": "$(check)",
        "when": "workspaceFolderCount != 0",
        "inputSchema": {
          "type": "object",
          "required": [
            "decision"
          ],
          "properties": {
            "decision": {
              "type": "string",
              "description": "The concise decision to save."
            },
            "reason": {
              "type": "string",
              "description": "Optional reason for the decision."
            },
            "evidence": {
              "type": "string",
              "description": "Optional source/evidence for the decision."
            }
          }
        }
      },
      {
        "name": "workstate_reconcile",
        "tags": [
          "workstate",
          "context",
          "git"
        ],
        "toolReferenceName": "workstateReconcile",
        "displayName": "Reconcile WorkState Context",
        "modelDescription": "Compares persisted WorkState context with current local Git/workspace evidence and returns a concise reconciliation summary. Use before resuming work after interruption, restart, branch change, or time away.",
        "userDescription": "Reconcile saved context with current workspace evidence.",
        "canBeReferencedInPrompt": true,
        "icon": "$(sync)",
        "when": "workspaceFolderCount != 0",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "workstate_get_handoff",
        "tags": [
          "workstate",
          "handoff",
          "context"
        ],
        "toolReferenceName": "workstateHandoff",
        "displayName": "Get WorkState Handoff",
        "modelDescription": "Generates a compact provider-independent handoff context for another AI coding agent. It uses the existing provider registry for target formatting and clearly falls back to copy-assisted handoff when direct injection is unavailable.",
        "userDescription": "Prepare a compact handoff for another AI coding agent.",
        "canBeReferencedInPrompt": true,
        "icon": "$(arrow-right)",
        "when": "workspaceFolderCount != 0",
        "inputSchema": {
          "type": "object",
          "properties": {
            "targetAgent": {
              "type": "string",
              "enum": [
                "Codex",
                "Claude",
                "Copilot",
                "Gemini",
                "Other"
              ],
              "description": "Target AI coding agent for handoff formatting.",
              "default": "Other"
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "WorkState",
      "properties": {
        "workstate.exclusions": {
          "type": "array",
          "default": [
            ".env",
            ".env.*",
            "**/.env",
            "**/.env.*",
            "**/*secret*",
            "**/*credential*",
            "**/credentials.json",
            "**/service-account.json",
            "**/*token*",
            "**/secret.txt",
            "**/token.txt",
            "**/*.pem",
            "**/*.key",
            "**/id_rsa",
            "**/id_ed25519"
          ],
          "items": {
            "type": "string"
          },
          "description": "Glob-like path patterns excluded from WorkState relevant files and handoffs."
        },
        "workstate.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable quiet, contextual WorkState notifications."
        },
        "workstate.notifications.welcomeBack": {
          "type": "boolean",
          "default": true,
          "description": "Show a welcome-back notification when meaningful previous context is restored."
        },
        "workstate.notifications.significantChanges": {
          "type": "boolean",
          "default": true,
          "description": "Suggest capturing progress after a meaningful batch of changed files."
        },
        "workstate.notifications.branchChanges": {
          "type": "boolean",
          "default": true,
          "description": "Show a contextual notice when the Git branch changes."
        },
        "workstate.contextCapture.mode": {
          "type": "string",
          "enum": [
            "automatic",
            "askWhenUncertain",
            "manual"
          ],
          "default": "automatic",
          "description": "Controls local deterministic context capture. High-confidence context can be saved automatically; uncertain context is held for review."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/vscode": "^1.92.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^8.57.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
